# Скопируйте в .env: cp .env.example .env (в .env не коммитится)
POSTGRES_USER=kcr
POSTGRES_PASSWORD=kcr
POSTGRES_DB=kcr

# Локальный запуск без Docker: закомментируйте DATABASE_URL —
# backend по умолчанию использует sqlite:///./kcr.db
# DATABASE_URL=postgresql+psycopg2://kcr:kcr@localhost:5432/kcr
